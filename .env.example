# Default: deterministic local samples. No API key or network call needed.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
# Live mode must be explicitly enabled. Keep it local; calls may incur charges.
# APP_MODE=live
# OPENAI_API_KEY=replace-with-your-own-key-locally
OPENAI_MODEL=gpt-4.1-mini
API_TIMEOUT_MS=12000
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_PER_MINUTE=12
MAX_CONCURRENT_REQUESTS=3
